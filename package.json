{
  "name": "xr-design",
  "version": "1.0.0",
  "description": "基于 Svelte 的 WEB 桌面端组件库",
  "keywords": [
    "svelte",
    "svelte5",
    "xr",
    "design",
    "xrd",
    "svelteComponent",
    "component",
    "components",
    "ui",
    "framework",
    "frontend"
  ],
  "license": "MIT",
  "homepage": "https://github.com/NathanCong/xr-design",
  "repository": {
    "type": "git",
    "url": "https://github.com/NathanCong/xr-design.git"
  },
  "bugs": {
    "url": "https://github.com/NathanCong/xr-design/issues"
  },
  "main": "dist/cjs/main.js",
  "types": "dist/types/main.d.ts",
  "module": "dist/esm/main.js",
  "unpkg": "dist/umd/xrd.min.js",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "site/*",
    "*.svelte",
    "*.md",
    "dist/umd/*",
    "*.css"
  ],
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "serve": "vite serve",
    "build:cjs": "vite build --mode cjs",
    "build:esm": "vite build --mode esm",
    "build:umd": "vite build --mode umd",
    "build:types": "",
    "build:dist": "pnpm run build:cjs && pnpm run build:esm && pnpm run build:umd && pnpm build:types",
    "build:site": "vite build --mode site",
    "build": "pnpm run build:dist && pnpm run build:site",
    "check": "eslint src",
    "check:fix": "eslint src --fix"
  },
  "dependencies": {
    "normalize.css": "^8.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "less": "^4.6.4",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.0.1",
    "svelte": "^5.56.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16"
  },
  "peerDependencies": {
    "svelte": "^5.56.2"
  }
}
